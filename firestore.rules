rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - name: string (required)
    //   - dailyCapacity: number (required)
    //   - activeAreas: list (required)
    //   - onboardingCompleted: boolean (required)
    //   - uid: string (required, immutable)
    //
    // Collection: tasks
    // Document ID: {taskId}
    // Fields:
    //   - title: string (required)
    //   - type: string (required)
    //   - area: string (required)
    //   - priority: string (required)
    //   - deadline: string (optional)
    //   - startDate: string (optional)
    //   - endDate: string (optional)
    //   - timeEstimate: number (required)
    //   - notes: string (optional)
    //   - status: string (required)
    //   - dateAllocated: string (optional)
    //   - isFixed: boolean (optional)
    //   - parentTaskId: string (optional)
    //   - userId: string (required, immutable)
    //   - createdAt: string (required, immutable)
    //
    // Collection: unforeseen_events
    // Document ID: {eventId}
    // Fields:
    //   - userId: string (required, immutable)
    //   - date: string (required)
    //   - duration: number (required)
    //   - description: string (required)
    //   - createdAt: string (required, immutable)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function userIdUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }

    function userIdNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function createdAtNotModified() {
      return !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.dailyCapacity is number && data.dailyCapacity > 0 && data.dailyCapacity <= 1440 &&
             data.activeAreas is list && data.activeAreas.size() <= 15 &&
             data.onboardingCompleted is bool &&
             data.uid == request.auth.uid;
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.type is string && data.type.size() > 0 && data.type.size() < 50 &&
             data.area is string && data.area.size() > 0 && data.area.size() < 50 &&
             data.priority is string && data.priority.size() > 0 && data.priority.size() < 20 &&
             data.timeEstimate is number && data.timeEstimate >= 0 && data.timeEstimate <= 1440 &&
             (!('deadline' in data) || (data.deadline is string && data.deadline.size() < 50)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() < 50)) &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.size() < 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.status in ['pending', 'completed'] &&
             (!('dateAllocated' in data) || (data.dateAllocated is string && data.dateAllocated.size() <= 20)) &&
             (!('isFixed' in data) || data.isFixed is bool) &&
             (!('parentTaskId' in data) || (data.parentTaskId is string && data.parentTaskId.size() < 50)) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() < 50)) &&
             data.userId == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 50;
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 150 &&
             data.area is string && data.area.size() > 0 && data.area.size() < 50 &&
             data.status in ['active', 'paused', 'completed'] &&
             data.userId == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 50;
    }

    function isValidRoutine(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 150 &&
             data.area is string && data.area.size() > 0 && data.area.size() < 50 &&
             data.startTime is string && data.startTime.size() <= 10 &&
             data.endTime is string && data.endTime.size() <= 10 &&
             data.userId == request.auth.uid;
    }

    function isValidUnforeseenEvent(data) {
      return data.userId == request.auth.uid &&
             data.date is string && data.date.size() > 0 && data.date.size() < 20 &&
             data.duration is number && data.duration > 0 && data.duration <= 1440 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 500 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 50;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasRequiredFields(['name', 'dailyCapacity', 'activeAreas', 'onboardingCompleted', 'uid']) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified();
      allow delete: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasRequiredFields(['title', 'type', 'area', 'priority', 'timeEstimate', 'status', 'userId', 'createdAt']) && isValidTask(request.resource.data) && userIdUnchanged();
      allow update: if isDocOwner() && isValidTask(request.resource.data) && userIdNotModified() && createdAtNotModified();
      allow delete: if isDocOwner();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasRequiredFields(['name', 'area', 'status', 'userId', 'createdAt']) && isValidProject(request.resource.data) && userIdUnchanged();
      allow update: if isDocOwner() && isValidProject(request.resource.data) && userIdNotModified() && createdAtNotModified();
      allow delete: if isDocOwner();
    }

    match /routines/{routineId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasRequiredFields(['title', 'area', 'startTime', 'endTime', 'userId']) && isValidRoutine(request.resource.data) && userIdUnchanged();
      allow update: if isDocOwner() && isValidRoutine(request.resource.data) && userIdNotModified();
      allow delete: if isDocOwner();
    }

    match /unforeseen_events/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && hasRequiredFields(['userId', 'date', 'duration', 'description', 'createdAt']) && isValidUnforeseenEvent(request.resource.data) && userIdUnchanged();
      allow update: if isDocOwner() && isValidUnforeseenEvent(request.resource.data) && userIdNotModified() && createdAtNotModified();
      allow delete: if isDocOwner();
    }
  }
}
